# Example key.properties (DO NOT COMMIT real secrets)
#
# File locations (keep these distinct):
#   this file     → android/key.properties
#   keystore file → android/app/keystore.jks
#
# storeFile below is relative to the android/app module directory.
storePassword=CHANGE_ME
keyPassword=CHANGE_ME
keyAlias=upload
storeFile=keystore.jks
