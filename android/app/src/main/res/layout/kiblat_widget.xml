<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_background"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="10dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/qibla_arrow"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@drawable/ic_qibla_arrow"
        android:scaleType="fitCenter"
        android:contentDescription="@string/widget_name" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.05"
        android:layout_marginStart="10dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/qibla_degree"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0° N"
            android:textColor="#D4AF37"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="295° NW" />

        <TextView
            android:id="@+id/location_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="Buka app untuk update"
            android:textColor="#9A9A9A"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="Jakarta, Indonesia" />
    </LinearLayout>

    <TextView
        android:layout_width="1dp"
        android:layout_height="42dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:background="#33D4AF37"
        android:text="" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.95"
        android:orientation="vertical">

        <TextView
            android:id="@+id/current_prayer_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_now"
            android:textAllCaps="true"
            android:textColor="#8D8D8D"
            android:textSize="9sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/current_prayer_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="--"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Dhuhr" />

            <TextView
                android:id="@+id/current_prayer_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="--:--"
                android:textColor="#D4AF37"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                tools:text="12:05" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.95"
        android:layout_marginStart="8dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/next_prayer_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_next"
            android:textAllCaps="true"
            android:textColor="#8D8D8D"
            android:textSize="9sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/next_prayer_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="--"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Asr" />

            <TextView
                android:id="@+id/next_prayer_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="--:--"
                android:textColor="#D4AF37"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                tools:text="15:30" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/refresh_button"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_marginStart="8dp"
        android:padding="3dp"
        android:src="@drawable/ic_refresh"
        android:contentDescription="@string/widget_name" />

</LinearLayout>
